# Local application environment
NODE_ENV=development
PORT=3000

# SQLite database location (relative to the project root)
SHOPVERSE_DATA_FILE=backend/data/shopverse.sqlite

# Optional one-time import source for the previous JSON data file
SHOPVERSE_LEGACY_DATA_FILE=backend/data/shopverse.json

# In Render production, set DATABASE_URL to the internal URL of a Render PostgreSQL database.
# The app requires DATABASE_URL in production to prevent data loss on ephemeral filesystems.

# --- Account sign-in and recovery ---------------------------------------------
# Google OAuth web client ID. Create a Web application OAuth client and allow the
# ShopVerse site origin in its authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Resend account API key and a verified sender address for password reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL="ShopVerse <accounts@example.com>"
# Canonical public origin used when building password reset links.
SHOPVERSE_PUBLIC_URL=http://localhost:3000

# --- Marketplace operations (see docs/OPERATIONS.md) ---------------------------
# Accounts that get the admin dashboard at /admin (comma-separated emails).
SHOPVERSE_ADMIN_EMAILS=

# Accounts customers pay into for protected payments. Leave blank to have
# ShopVerse contact the customer with payment details instead.
SHOPVERSE_PAY_ACCOUNT_NAME=
SHOPVERSE_PAY_MTN=
SHOPVERSE_PAY_AIRTEL=
SHOPVERSE_PAY_ZAMTEL=
SHOPVERSE_PAY_BANK=

# Commission deducted from seller payouts, as a percent of item value (0 at launch).
SHOPVERSE_COMMISSION_PERCENT=0

# Only admin-verified shops are visible to buyers and can sell (default). Set to false
# to let unverified shops sell.
SHOPVERSE_REQUIRE_VERIFICATION=true
